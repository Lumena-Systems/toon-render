{
  "name": "@json-render/toon",
  "version": "0.11.0",
  "license": "Apache-2.0",
  "description": "TOON (Token-Oriented Object Notation) format support for json-render. Encode specs and prompts in TOON for 30-60% fewer LLM tokens.",
  "keywords": [
    "json",
    "toon",
    "ai",
    "llm",
    "token-efficient",
    "generative-ui",
    "json-render",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/json-render.git",
    "directory": "packages/toon"
  },
  "homepage": "https://github.com/vercel-labs/json-render#readme",
  "bugs": {
    "url": "https://github.com/vercel-labs/json-render/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@json-render/core": "workspace:*",
    "@toon-format/toon": "^2.1.0"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
